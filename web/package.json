{
  "name": "panelist-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "bundle": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "selfcheck": "esbuild src/selfcheck.ts --bundle --platform=node --format=esm --outfile=.selfcheck/selfcheck.mjs --log-level=warning && node .selfcheck/selfcheck.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "typescript": "^5.7.2",
    "vite": "7.3.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
